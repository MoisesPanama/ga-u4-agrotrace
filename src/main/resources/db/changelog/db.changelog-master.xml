<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="agrotrace">
        <createTable tableName="finca">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="nombre" type="VARCHAR(100)" nullable="false"/>
            <column name="ubicacion" type="VARCHAR(200)"/>
            <column name="hectareas" type="DOUBLE"/>
            <column name="productor_nombre" type="VARCHAR(150)" nullable="false"/>
            <column name="productor_cedula" type="VARCHAR(20)" nullable="false"/>
        </createTable>

        <createTable tableName="lote">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="codigo" type="VARCHAR(50)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="finca_id" type="BIGINT">
                <constraints foreignKeyName="fk_lote_finca" references="finca(id)"/>
            </column>
            <column name="fecha_recepcion" type="DATE" nullable="false"/>
            <column name="peso_kg" type="DECIMAL(10,2)" nullable="false"/>
            <column name="fermentacion_porcentaje" type="DECIMAL(5,2)"/>
            <column name="humedad_porcentaje" type="DECIMAL(5,2)"/>
            <column name="estado" type="VARCHAR(30)" defaultValue="REGISTRADO"/>
            <column name="observaciones" type="TEXT"/>
            <column name="certificado" type="BOOLEAN" defaultValue="false"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

