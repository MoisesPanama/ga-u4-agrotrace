    <changeSet id="1" author="agrotrace">
        <createTable tableName="lote">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="codigo" type="VARCHAR(50)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="productor_nombre" type="VARCHAR(150)" nullable="false"/>
            <column name="productor_cedula" type="VARCHAR(20)" nullable="false"/>
            <column name="finca_nombre" type="VARCHAR(100)"/>
            <column name="finca_ubicacion" type="VARCHAR(200)"/>
            <column name="variedad" type="VARCHAR(50)" defaultValue="CRILLO"/>
            <column name="hectareas" type="DECIMAL(6,2)"/>
            <column name="fecha_cosecha" type="DATE" nullable="false"/>
            <column name="fecha_procesamiento" type="DATE"/>
            <column name="peso_kg" type="DECIMAL(10,2)" nullable="false"/>
            <column name="humedad_porcentaje" type="DECIMAL(5,2)"/>
            <column name="fermentacion_horas" type="INTEGER"/>
            <column name="temperatura_maxima" type="DECIMAL(5,2)"/>
            <column name="temperatura_minima" type="DECIMAL(5,2)"/>
            <column name="estado" type="VARCHAR(30)" defaultValue="REGISTRADO"/>
            <column name="observaciones" type="TEXT"/>
            <column name="certificado" type="BOOLEAN" defaultValue="false"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

